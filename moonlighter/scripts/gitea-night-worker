#!/usr/bin/env bash
# One safe-boundary invocation; systemd repeats it within the configured window.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"
STATE_DIR="${XDG_STATE_HOME:-${HOME}/.local/state}/gitea-night"
PYTHON="${PYTHON:-$(command -v python3 || true)}"
FLOCK="${FLOCK:-$(command -v flock || true)}"

mkdir -p "${STATE_DIR}"
if [ -f "${STATE_DIR}/paused" ]; then
    echo "gitea-night is paused"
    exit 0
fi
if [ -z "${PYTHON}" ]; then
    echo "python3 is required" >&2
    exit 127
fi
if [ -z "${FLOCK}" ]; then
    echo "flock is required" >&2
    exit 127
fi

cd "${PROJECT_DIR}"
export PYTHONPATH="${SCRIPT_DIR}${PYTHONPATH:+:${PYTHONPATH}}"
exec "${PYTHON}" -m gitea_night.worker "$@"
