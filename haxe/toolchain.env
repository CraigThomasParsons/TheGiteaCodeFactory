# Pinned Haxe toolchain for this kit. Sourced (not executed) by
# scripts/install-haxe.sh, scripts/build-haxe.sh and scripts/check-haxe.sh.
#
# To change a version: update it here with the new SHA-256, update .haxerc or
# the matching haxe_libraries/<name>.hxml to the same version, rebuild with
# `bash scripts/build-haxe.sh`, and commit the regenerated files.
# check-haxe.sh fails when these pins and the lix files disagree.

GCF_HAXE_VERSION=4.3.7
GCF_HAXE_LINUX64_URL=https://github.com/HaxeFoundation/haxe/releases/download/4.3.7/haxe-4.3.7-linux64.tar.gz
GCF_HAXE_LINUX64_SHA256=a156b3d039daa572f1f9329870ee753e3c39b7514fe8c818069323579659acca

# Libraries, as name:version:sha256 of the archive lib.haxe.org serves at
# https://lib.haxe.org/p/<name>/<version>/download/
GCF_HAXE_LIBS="utest:1.13.2:6fb0305fcb1264f12aa3988a0f1234ffb7298536f85c88b85ec15b267fdd7b75 hxnodejs:12.2.0:97c82e99bbf48bc8c0d9cb62afe35e029a14975ca0d488aee088739c68216380"
