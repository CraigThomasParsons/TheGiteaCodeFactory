# Copy to .env. Ports avoid the common defaults of an existing Gitea (3000) and
# Paperclip (3100) on the same host; change them if yours differ.
GITEA_IMAGE=docker.io/gitea/gitea:1.27.3
GITEA_RUNNER_IMAGE=docker.io/gitea/runner:4.0.0
GITEA_BIND_ADDRESS=127.0.0.1
GITEA_DOMAIN=localhost
GITEA_ROOT_URL=http://localhost:3300/
GITEA_HTTP_PORT=3300
GITEA_SSH_PORT=2223
USER_UID=1000
USER_GID=1000
